# GIMP shortcutsrc
#
# Photoshop-style keybindings for GIMP 3, managed by nix-mep.
# Mirrors PhotoGIMP's intent — upstream PhotoGIMP only ships GIMP 2.10's
# menurc, which GIMP 3 ignores. This file is the GIMP 3 equivalent.
#
# This file is reinstalled by the home-manager activation script whenever its
# content hash changes. Your in-GIMP customizations persist until you bump
# this file in the repo; then nix-mep's version wins on the next `just switch`.
# To force a refresh manually: delete ~/.config/GIMP/3.0/shortcutsrc and rebuild.

(file-version 1)

# === FILE ===
(action "image-new"           "<Primary>n")
(action "file-open"           "<Primary>o")
(action "file-save"           "<Primary>s")
(action "file-save-as"        "<Primary><Shift>s")
(action "file-save-a-copy"    "<Primary><Alt>s")
(action "file-export-as"      "<Primary><Shift><Alt>s")
(action "file-print-gtk"      "<Primary>p")
(action "view-close"          "<Primary>w")
(action "file-quit"           "<Primary>q")

# === EDIT ===
(action "edit-undo"           "<Primary>z")
(action "edit-redo"           "<Primary><Shift>z")
(action "edit-strong-undo"    "<Primary><Alt>z")
(action "edit-cut"            "<Primary>x")
(action "edit-copy"           "<Primary>c")
(action "edit-copy-visible"   "<Primary><Shift>c")
(action "edit-paste"          "<Primary>v")
(action "edit-paste-in-place" "<Primary><Shift>v")
(action "filters-repeat"      "<Primary>f")
(action "filters-reshow"      "<Primary><Shift>f")
(action "edit-fill-bg"        "BackSpace")
(action "edit-fill-fg"        "<Alt>BackSpace")
(action "edit-fill-pattern"   "<Shift>BackSpace")

# === IMAGE ===
(action "image-scale"         "<Primary><Alt>i")
(action "image-resize"        "<Primary><Alt>c")
(action "image-duplicate"     "<Primary><Alt>d")
(action "image-properties"    "<Primary><Alt>p")

# === LAYER ===
(action "layers-new"               "<Primary><Shift>n")
(action "layers-duplicate"         "<Primary>j")
(action "layers-new-from-visible"  "<Primary><Shift><Alt>e")
(action "layers-merge-down"        "<Primary>e")
(action "image-flatten"            "<Primary><Shift>e")
(action "layers-new-group"         "<Primary>g")
(action "layers-mask-add"          "<Primary><Alt>g")
(action "layers-raise"             "<Primary>bracketright")
(action "layers-lower"             "<Primary>bracketleft")
(action "layers-raise-to-top"      "<Primary><Shift>bracketright")
(action "layers-lower-to-bottom"   "<Primary><Shift>bracketleft")

# === SELECT ===
(action "select-all"          "<Primary>a")
(action "select-none"         "<Primary>d")
(action "select-invert"       "<Primary><Shift>i")
(action "select-feather"      "<Shift>F6")

# === VIEW ===
(action "view-zoom-fit-in"    "<Primary>0")
(action "view-zoom-1-1"       "<Primary>1")
(action "view-zoom-in"        "<Primary>equal")
(action "view-zoom-out"       "<Primary>minus")
(action "view-fullscreen"     "F11")
(action "view-navigation-window" "F2")

# === DIALOGS ===
(action "dialogs-layers"      "F7")
(action "dialogs-brushes"     "F5")
(action "dialogs-colors"      "F6")
(action "dialogs-histogram"   "F9")
(action "dialogs-action-search" "<Shift>F4")

# === COLOR ADJUSTMENTS (Photoshop's Image > Adjustments) ===
(action "tools-levels"             "<Primary>l")
(action "tools-curves"             "<Primary>m")
(action "filters-hue-saturation"   "<Primary>u")
(action "filters-color-balance"    "<Primary>b")
(action "filters-brightness-contrast" "<Primary><Shift>b")
(action "filters-desaturate"       "<Primary><Shift>u")
(action "filters-invert-perceptual" "<Primary>i")

# === TOOLS (Photoshop single-letter shortcuts) ===
(action "tools-move"               "v")
(action "tools-rect-select"        "m")
(action "tools-free-select"        "l")
(action "tools-fuzzy-select"       "w")
(action "tools-crop"               "c")
(action "tools-color-picker"       "i")
(action "tools-paintbrush"         "b")
(action "tools-pencil"             "n")
(action "tools-eraser"             "e")
(action "tools-bucket-fill"        "g")
(action "tools-gradient"           "<Shift>g")
(action "tools-vector"             "p")
(action "tools-text"               "t")
(action "tools-zoom"               "z")
(action "tools-heal"               "j")
(action "tools-clone"              "s")
(action "tools-convolve"           "r")
(action "tools-dodge-burn"         "o")
(action "tools-smudge"             "<Shift>s")
(action "tools-unified-transform"  "<Primary>t")
(action "tools-rotate"             "<Primary><Shift>r")
(action "tools-scale"              "<Primary><Shift>t")
(action "context-colors-swap"      "x")
(action "context-colors-default"   "d")

# === BRUSH SIZE (Photoshop [ and ]) ===
(action "context-brush-radius-decrease" "bracketleft")
(action "context-brush-radius-increase" "bracketright")
(action "context-brush-hardness-decrease" "<Shift>bracketleft")
(action "context-brush-hardness-increase" "<Shift>bracketright")
